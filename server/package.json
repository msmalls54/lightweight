{
  "name": "lightweight-server",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.2" },
  "version": "0.1.0",
  "description": "Lightweight: EMG receiver, signal engine, dashboard, Gemini voice coach and MCP tools",
  "scripts": {
    "dev": "mcp-use dev --no-open --no-hmr",
    "start": "mcp-use start",
    "build": "tsc --noEmit && mcp-use build --with-inspector --inline --no-typecheck",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "3.3.0",
    "@mcp-use/tunnel": "0.2.2",
    "better-sqlite3": "13.0.3",
    "mcp-use": "1.34.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@hono/node-server": "1.19.17",
    "hono": "4.13.13",
    "posthog-js": "1.438.12"
  }
}
